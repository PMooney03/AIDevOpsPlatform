{
  "uid": "incident-metrics",
  "title": "Incident Metrics",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Active incidents",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "devops_incidents_open",
          "legendFormat": "open + investigating"
        }
      ]
    },
    {
      "id": 2,
      "type": "piechart",
      "title": "Open incidents by severity",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "devops_incidents_open_by_severity",
          "legendFormat": "{{severity}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Incident counter events",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (action) (increase(devops_incidents_total[5m]))",
          "legendFormat": "{{action}}"
        }
      ]
    }
  ]
}
