# Copy this file to .env and adjust values for local development.
# Never commit the real .env file.

POSTGRES_USER=devops
POSTGRES_PASSWORD=dev_only_change_me
POSTGRES_DB=devops_platform
POSTGRES_PORT=5432
API_PORT=8080

MONITORING_INTERVAL=00:00:15
MONITORING_REQUEST_TIMEOUT=00:00:05
MONITORING_DEGRADED_RESPONSE_TIME_MS=1000
MONITORING_UNHEALTHY_FAILURE_THRESHOLD=3
MONITORING_OFFLINE_UNREACHABLE_PERIOD=00:01:00

WORKER_METRICS_PORT=9464
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Local LLM used by incident analysis. Compose starts Ollama and pulls this model.
# Set OLLAMA_ENABLED=false only if you need a no-model demo.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=00:04:00

AUTH_ENABLED=true
AUTH_SIGNING_KEY=dev-only-change-me-use-a-32-char-key!

DASHBOARD_PORT=8081
